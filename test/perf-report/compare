# -*- mode: shell-script -*-
# ``--compare`` scores a report against the targets and a baseline, one
# line per target/guard on stdout, fail-closed: exit 1 on anything
# regressed, missing, failed or invalid; exit 2 on malformed input.

source "$base/test/perf-report/helpers.sh"

ALL_RUNS='[{scope: lib, filter: "a::", state: passed}, {scope: lib, filter: "a_pre::", state: passed}, {scope: perf, filter: "b::", state: passed}]'
export ALL_RUNS

setup() {
    perf_report_fixtures
}

try '
source "$base/test/perf-report/helpers.sh"
perf_report_candidate "$ALL_RUNS" <<YAML
results:
  item-a:
    c1: {calls: 1, wait-ms: 400, latency-ms: 250, extra: 2}
    c2: {invariant: 7}
  item-b:
    c3: {flag: 1}
YAML
perf_report_compare
' "every target met"
is errlvl 0
is out 'met item-a c1 calls baseline=3 now=1 target="<= 1" delta=-2 kind=work
met item-a c1 wait-ms baseline=1000 now=400 target="<= 0.5x" delta=-600 kind=timing
met item-a c1 latency-ms baseline=400 now=250 target="-100" delta=-150 kind=timing
met item-a c1 extra baseline=2 now=2 target="<= 10" delta=+0 kind=work advisory
met item-a c2 invariant baseline=7 now=7 target="== 7" delta=+0 kind=work
met item-b c3 flag baseline=0 now=1 target="== 1" delta=+1 kind=work' TRIM

try '
source "$base/test/perf-report/helpers.sh"
perf_report_candidate "$ALL_RUNS" <<YAML
results:
  item-a:
    c1: {calls: 3, wait-ms: 1300, latency-ms: 350, extra: 9}
    c2: {invariant: 6}
  item-b:
    c3: {other: 1}
YAML
perf_report_compare
' "worse inside a loose target, broken guard, metric missing"
is errlvl 1
is out 'not-met item-a c1 calls baseline=3 now=3 target="<= 1" delta=+0 kind=work
regressed item-a c1 wait-ms baseline=1000 now=1300 target="<= 0.5x" delta=+300 kind=timing
not-met item-a c1 latency-ms baseline=400 now=350 target="-100" delta=-50 kind=timing
regressed item-a c1 extra baseline=2 now=9 target="<= 10" delta=+7 kind=work advisory
regressed item-a c2 invariant baseline=7 now=6 target="== 7" delta=-1 kind=work
missing item-b c3 flag baseline=0 now=- target="== 1" delta=- kind=work' TRIM

try '
source "$base/test/perf-report/helpers.sh"
perf_report_candidate "[]" <<YAML
results: {}
YAML
perf_report_compare | cut -d" " -f1 | sort | uniq -c
' "nothing ran: everything skipped, no failure"
is errlvl 0
is out "6 skipped" TRIM

try '
source "$base/test/perf-report/helpers.sh"
perf_report_candidate "$ALL_RUNS" <<YAML
results:
  item-a:
    c1: {calls: 1, wait-ms: 400, latency-ms: 250, extra: 2}
    c2: {invariant: 7}
YAML
perf_report_compare | grep item-b
' "a cut whose test ran but produced nothing is failed, not skipped"
is out 'failed item-b c3 flag baseline=0 now=- target="== 1" delta=- kind=work' TRIM

try '
source "$base/test/perf-report/helpers.sh"
perf_report_candidate "[{scope: lib, filter: \"a::\", state: failed}]" <<YAML
results: {}
YAML
perf_report_compare | grep -c "^failed item-a"
' "a failed test marks its cuts failed"
is out "5" TRIM

try '
source "$base/test/perf-report/helpers.sh"
perf_report_candidate "$ALL_RUNS" <<YAML
results:
  item-a:
    c1: {calls: "0garbage", wait-ms: .nan, latency-ms: 250, extra: 2}
    c2: {invariant: 7}
  item-b:
    c3: {flag: 1}
YAML
perf_report_compare; echo "rc=$?"
' "non-numeric and non-finite values are invalid"
is out part 'invalid item-a c1 calls baseline=3 now=0garbage'
is out part 'invalid item-a c1 wait-ms baseline=1000'
is out part 'rc=1'

try '
source "$base/test/perf-report/helpers.sh"
sed -i "s/target: \"<= 1\"/target: \"banana\"/" "$test_tmpdir/targets.yaml"
perf_report_candidate "$ALL_RUNS" <<YAML
results: {}
YAML
perf_report_compare
' "an unparsable criterion rejects the targets file"
is errlvl 2
is err part "unparsable criterion"

try '
source "$base/test/perf-report/helpers.sh"
printf "results: [unclosed\n" > "$test_tmpdir/now.yaml"
perf_report_compare
' "malformed report YAML is an input error"
is errlvl 2
is err part "not valid YAML"

try '
source "$base/test/perf-report/helpers.sh"
yq -i "del(.results[\"item-a\"].c1[\"wait-ms\"])" "$test_tmpdir/baseline.yaml"
perf_report_candidate "$ALL_RUNS" <<YAML
results:
  item-a:
    c1: {calls: 1, wait-ms: 400, latency-ms: 250, extra: 2}
    c2: {invariant: 7}
  item-b:
    c3: {flag: 1}
YAML
perf_report_compare | grep wait-ms
' "a relative criterion without a baseline value is invalid"
is out 'invalid item-a c1 wait-ms baseline=- now=400 target="<= 0.5x" delta=- kind=timing' TRIM

try '
source "$base/test/perf-report/helpers.sh"
printf "results:\n  item-a:\n    c1: {calls: 1}\n" > "$test_tmpdir/now.yaml"
perf_report_compare
' "a report without its run manifest is an input error"
is errlvl 2
is err part "run manifest"

try '
source "$base/test/perf-report/helpers.sh"
printf "noise:\n  item-a:\n    c1: {wait-ms: 0.5}\n" >> "$test_tmpdir/baseline.yaml"
perf_report_candidate "$ALL_RUNS" <<YAML
results:
  item-a:
    c1: {calls: 1, wait-ms: 1600, latency-ms: 250, extra: 2}
    c2: {invariant: 7}
  item-b:
    c3: {flag: 1}
YAML
perf_report_compare | grep wait-ms
' "a calibrated noise margin widens the timing regression threshold"
is out 'not-met item-a c1 wait-ms baseline=1000 now=1600 target="<= 0.5x" delta=+600 kind=timing' TRIM

try '
source "$base/test/perf-report/helpers.sh"
cp "$test_tmpdir/baseline.yaml" "$test_tmpdir/b2.yaml"
yq -i ".results[\"item-a\"].c1[\"wait-ms\"] = 1500 | .runs = []" "$test_tmpdir/b2.yaml"
"$base/bin/perf-score" --calibrate "$test_tmpdir/baseline.yaml" "$test_tmpdir/b2.yaml" | yq ".noise[\"item-a\"].c1[\"wait-ms\"]"
' "calibration records the relative drift between two runs"
is out "0.333" TRIM
