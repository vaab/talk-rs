#!/usr/bin/env bash
#
# Run the talk-rs performance suite, collect its metrics into one YAML
# report, and score a report against perf/targets.yaml and a baseline
# (scoring itself is done by ``bin/perf-score``).
#
# Data (the report, or the comparison table) goes to stdout; progress
# and cargo output go to stderr.

set -euo pipefail

exname="${0##*/}"
self_dir=$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")
base=$(realpath -- "$self_dir/..")
version="0.2.0"

die()  { echo "Error: $*" >&2; exit 2; }
info() { echo "$*" >&2; }

usage() {
    cat <<EOF
Usage: $exname [RUN OPTIONS]
       $exname --compare BASELINE.yaml [--report REPORT.yaml] [OPTIONS]
       $exname --compare BASELINE.yaml --item ID --strict [OPTIONS]

Run the talk-rs performance suite (debug build, feature
\`perf-counters\`, serial) and print a YAML report on stdout.  The
report records every test selection run, whether it included ignored
tests, and its outcome.

With --compare, score a report against perf/targets.yaml and the given
baseline report, one line per target or guard:

    <status> <item> <cut> <metric> baseline=<b> now=<v> target="<t>" delta=<d> kind=<k>[ advisory]

  met / not-met   the criterion holds / does not hold
  regressed       a guard does not hold, or the metric moved in its
                  "worse" direction beyond noise (work: 10 %; timing:
                  25 % and 20 units), whether or not its target is met;
                  an "==" target regresses when a value the baseline
                  satisfied is lost
  missing         the cut ran but did not record the metric
  failed          the cut's test (or a prerequisite) ran and failed, or
                  was selected but produced no results
  skipped         the cut was not selected in this run
  invalid         non-numeric/non-finite value, bad criterion, or a
                  relative criterion without a baseline value

Exit status: 0 when nothing is regressed/missing/failed/invalid (and,
with --strict, the item is accepted); 1 otherwise; 2 on usage or
malformed input.

Run options:
  --item ID           run exactly what item ID needs: its perf tests
                      (ignored ones included) and its prerequisite
                      correctness tests
  --ignored           also run #[ignore]d cuts (long, display, model)
  --display           add only the isolated-display cuts
  --models            add the local-model cuts; needs
                      \$TALK_RS_TEST_PARAKEET_MODEL_DIR and/or
                      \$TALK_RS_TEST_KOKORO_MODEL_DIR
  --all               --ignored plus --models plus every item's
                      prerequisite tests
  --repeat N          repetitions per timing cut (default 5)
  -o, --output FILE   also write the report to FILE
  --results-dir DIR   keep raw per-cut metric files and logs in DIR

Compare options:
  --compare BASELINE  score a report against BASELINE and the targets
  --report REPORT     score REPORT instead of running the suite
  --strict            with --item: accept only if every cut of the item
                      ran, every non-advisory target is met, every
                      prerequisite passed, and nothing regressed
  --targets FILE      targets file (default: perf/targets.yaml)

  -h, --help          show this help
  --version           show version

Environment:
  TALK_RS_TEST_PARAKEET_MODEL_DIR   Parakeet model dir (model cuts)
  TALK_RS_TEST_KOKORO_MODEL_DIR     Kokoro model dir (model cuts)
  NO_COLOR                          disable colored status words

Examples:
  $exname --all -o perf/baseline.yaml
  $exname --compare perf/baseline.yaml --item paste-focus-sleep --strict
  $exname --compare perf/baseline.yaml --report /tmp/exp.yaml
EOF
}

run_ignored=
run_display=
run_models=
run_prereqs=
repeat=5
output=
compare=
report=
item=
strict=
targets="$base/perf/targets.yaml"
results_dir=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --ignored) run_ignored=1 ;;
        --display) run_display=1 ;;
        --models) run_models=1 ;;
        --all) run_ignored=1; run_models=1; run_prereqs=1 ;;
        --repeat) [ "$#" -ge 2 ] || die "$1 needs a number"; repeat="$2"; shift ;;
        -o|--output) [ "$#" -ge 2 ] || die "$1 needs a file"; output="$2"; shift ;;
        --compare) [ "$#" -ge 2 ] || die "$1 needs a file"; compare="$2"; shift ;;
        --report) [ "$#" -ge 2 ] || die "$1 needs a file"; report="$2"; shift ;;
        --item) [ "$#" -ge 2 ] || die "$1 needs an item id"; item="$2"; shift ;;
        --strict) strict=1 ;;
        --targets) [ "$#" -ge 2 ] || die "$1 needs a file"; targets="$2"; shift ;;
        --results-dir) [ "$#" -ge 2 ] || die "$1 needs a directory"; results_dir="$2"; shift ;;
        -h|--help) usage; exit 0 ;;
        --version) echo "$exname $version"; exit 0 ;;
        --) shift; break ;;
        *) die "unknown argument: $1 (see --help)" ;;
    esac
    shift
done
[ "$#" -eq 0 ] || die "unexpected argument: $1 (see --help)"
[ -z "$report" ] || [ -n "$compare" ] || die "--report needs --compare"
[ -z "$strict" ] || [ -n "$item" ] || die "--strict needs --item"
[ -z "$strict" ] || [ -n "$compare" ] || die "--strict needs --compare"
[[ "$repeat" =~ ^[1-9][0-9]*$ ]] || die "--repeat needs a positive integer"
[ -f "$targets" ] || die "targets file not found: $targets"

command -v yq >/dev/null || die "yq is required (https://github.com/mikefarah/yq)"

## Test selections (scope<TAB>name<TAB>filter<TAB>ignored) to run.
selections() {
    # Empty fields are written as "-" (read collapses empty TSV fields).
    if [ -n "$item" ]; then
        yq ".items[\"$item\"] as \$v
            | ((\$v.tests // []) | map([.scope, (.name // \"-\"), (.filter // \"-\"), \"1\"]))
            + ((\$v.prerequisites // []) | map([.scope, (.name // \"-\"), (.filter // \"-\"), \"0\"]))
            | .[] | map(select(. != \"\") // \"-\") | @tsv" "$targets" | grep -v '^$'
        return
    fi
    printf 'lib\t-\tperf_\t%s\n' "${run_ignored:-0}"
    printf 'perf\t-\t-\t%s\n' "${run_ignored:-0}"
    if [ -z "$run_ignored" ] && [ -n "$run_display" ]; then
        printf 'perf\t-\tperf_overlay\tonly\nperf\t-\tperf_record_ui\tonly\n'
    fi
    if [ -z "$run_ignored" ] && [ -n "$run_models" ]; then
        printf 'perf\t-\tperf_parakeet\tonly\nperf\t-\tperf_speak\tonly\n'
    fi
    if [ -n "$run_prereqs" ]; then
        # shellcheck disable=SC2016 # yq expression, not shell
        yq '.items[].prerequisites[] | [.scope, (.name // "-"), (.filter // "-"), "0"]
            | map(select(. != "") // "-") | @tsv' "$targets" | grep -v '^$' | sort -u
    fi
}

## Run the selections; writes metrics + a run manifest under $1, then
## prints the assembled report on stdout.
run_suite() {
    local out_dir="$1" log="$1/cargo.log"
    local features="perf-counters"
    command -v cargo >/dev/null || die "cargo is required"
    (cd "$base" && ./autogen.sh >"$out_dir/autogen.log" 2>&1) \
        || { cat "$out_dir/autogen.log" >&2; die "./autogen.sh failed"; }
    export TALK_RS_PERF_OUT="$out_dir/metrics" TALK_RS_PERF_REPEAT="$repeat"
    mkdir -p "$TALK_RS_PERF_OUT"
    info "perf: building (features: $features)"
    (cd "$base" && cargo test --features "$features" --no-run >"$log" 2>&1) \
        || { tail -n 60 "$log" >&2; die "build failed"; }

    : >"$out_dir/runs.tsv"
    local scope name filter ignored state
    while IFS=$'\t' read -r scope name filter ignored; do
        [ "$name" != - ] || name=""
        [ "$filter" != - ] || filter=""
        local -a cargo_args=(--features "$features") libtest=(--test-threads=1)
        case "$scope" in
            lib) cargo_args+=(--lib) ;;
            perf) cargo_args+=(--test perf) ;;
            test) cargo_args+=(--test "$name") ;;
            *) die "unknown test scope: $scope" ;;
        esac
        case "$ignored" in
            1) libtest+=(--include-ignored) ;;
            only) libtest+=(--ignored) ;;
        esac
        [ -z "$filter" ] || libtest+=("$filter")
        info "perf: running $scope${name:+/$name} ${filter:-<all>}"
        state=passed
        (cd "$base" && cargo test "${cargo_args[@]}" -- "${libtest[@]}" >>"$log" 2>&1) || state=failed
        [ "$state" = passed ] || info "perf: FAILED: $scope${name:+/$name} ${filter:-<all>} (see $log)"
        printf '%s\t%s\t%s\t%s\t%s\n' "$scope" "${name:--}" "${filter:--}" "$ignored" "$state" >>"$out_dir/runs.tsv"
    done < <(selections)
    grep -h '^SKIP' "$log" | sort -u >"$out_dir/skips.txt" || true
    [ ! -s "$out_dir/skips.txt" ] || info "perf: $(wc -l <"$out_dir/skips.txt") skip notice(s) (see report)"
    assemble "$out_dir"
}

## Merge per-cut metric files and the run manifest into one report.
assemble() {
    local dir="$1" f key seen=""
    local -a files=()
    shopt -s nullglob
    files=("$dir"/metrics/*.yaml)
    shopt -u nullglob
    for f in "${files[@]}"; do
        yq '.' "$f" >/dev/null 2>&1 || die "malformed metrics file: $f"
        [ "$(yq '.status' "$f")" = "ran" ] || die "metrics file without status ran: $f"
        key="$(yq '.item + "--" + .cut' "$f")"
        [ "${f##*/}" = "$key.yaml" ] || die "metrics file name/identity mismatch: $f"
        case " $seen " in *" $key "*) die "duplicate metrics for $key" ;; esac
        seen="$seen $key"
    done
    echo "# talk-rs performance report"
    echo "generated: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "commit: $(git -C "$base" rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "host: $(uname -n)"
    echo "build: debug, features perf-counters, serial, repeat $repeat"
    echo "runs:"
    local scope name filter ignored state line
    while IFS=$'\t' read -r scope name filter ignored state; do
        [ "$name" != - ] || name=""
        [ "$filter" != - ] || filter=""
        printf '  - {scope: %s, name: "%s", filter: "%s", ignored: "%s", state: %s}\n' \
            "$scope" "$name" "$filter" "$ignored" "$state"
    done <"$dir/runs.tsv"
    echo "skips:"
    while IFS= read -r line; do
        printf "  - '%s'\n" "${line//\'/\'\'}"
    done <"$dir/skips.txt"
    if [ "${#files[@]}" -gt 0 ]; then
        # shellcheck disable=SC2016 # yq expression, not shell
        yq eval-all '. as $x ireduce ({}; . * {"results": {$x.item: {$x.cut: $x.metrics}}})' "${files[@]}"
    else
        echo "results: {}"
    fi
}

work_dir=$(mktemp -d "${TMPDIR:-/tmp}/talk-rs-perf.XXXXXX")
cleanup() { rm -rf "$work_dir"; }
trap cleanup EXIT
trap 'exit 130' INT TERM

if [ -n "$item" ]; then
    [ "$(yq ".items | has(\"$item\")" "$targets")" = "true" ] || die "unknown item: $item (see $targets)"
fi

if [ -n "$report" ]; then
    current="$report"
else
    current="$work_dir/report.yaml"
    run_suite "$work_dir" >"$current"
    if [ -n "$results_dir" ]; then
        mkdir -p "$results_dir"
        cp -r "$work_dir"/metrics "$work_dir"/*.log "$work_dir/runs.tsv" "$results_dir"/
    fi
    if [ -n "$output" ]; then
        cp "$current" "$output"
        info "perf: report written to $output"
    fi
fi

if [ -n "$compare" ]; then
    command -v python3 >/dev/null || die "python3 (with PyYAML) is required for --compare"
    args=(--targets "$targets" --report "$current" --baseline "$compare")
    [ -z "$item" ] || args+=(--item "$item")
    [ -z "$strict" ] || args+=(--strict)
    [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ] || args+=(--color)
    "$self_dir/perf-score" "${args[@]}"
elif [ -z "$report" ]; then
    cat "$current"
fi
